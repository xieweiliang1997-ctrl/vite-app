# 前端构建产物（Docker 内部会重新打包，无需复制）
dist/
build/
dist-ssr/
*.local

# 依赖目录（Docker 内部会重新安装，无需复制）
node_modules/
.pnp/
.pnp.js

# 版本控制文件（无用）
.git/
.gitignore
.github/

# 日志和缓存文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.vite/
.idea/
.vscode/
*.swp
*.swo

# 环境文件（避免敏感信息打包进镜像）
.env
.env.local
.env.development.local
.env.production.local